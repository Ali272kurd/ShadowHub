local function createToggle(card, text, configKey, yPos)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 0, 26)
    label.Position = UDim2.new(0, 10, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = "> " .. text
    label.TextColor3 = Color3.fromRGB(180, 255, 180)
    label.TextSize = 11
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 42, 0, 20)
    toggleBtn.Position = UDim2.new(1, -50, 0, yPos + 3)
    toggleBtn.BackgroundColor3 = getgenv().CamlockConfig[configKey] and Color3.fromRGB(0, 50, 15) or Color3.fromRGB(20, 20, 20)
    toggleBtn.BorderSizePixel = 1
    toggleBtn.BorderColor3 = getgenv().CamlockConfig[configKey] and Color3.fromRGB(0, 255, 65) or Color3.fromRGB(80, 80, 80)
    toggleBtn.Text = getgenv().CamlockConfig[configKey] and "[ON]" or "[OFF]"
    toggleBtn.TextColor3 = getgenv().CamlockConfig[configKey] and Color3.fromRGB(0, 255, 65) or Color3.fromRGB(150, 150, 150)
    toggleBtn.TextSize = 9
    toggleBtn.Font = Enum.Font.Code
    toggleBtn.AutoButtonColor = false
    toggleBtn.Parent = card

    toggleBtn.MouseButton1Click:Connect(function()
        getgenv().CamlockConfig[configKey] = not getgenv().CamlockConfig[configKey]
        local state = getgenv().CamlockConfig[configKey]
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 50, 15) or Color3.fromRGB(20, 20, 20)
        toggleBtn.BorderColor3 = state and Color3.fromRGB(0, 255, 65) or Color3.fromRGB(80, 80, 80)
        toggleBtn.Text = state and "[ON]" or "[OFF]"
        toggleBtn.TextColor3 = state and Color3.fromRGB(0, 255, 65) or Color3.fromRGB(150, 150, 150)
    end)
end

local function createSlider(card, text, configKey, minVal, maxVal, yPos, unit)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 0, 18)
    label.Position = UDim2.new(0, 10, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = "> " .. text
    label.TextColor3 = Color3.fromRGB(180, 255, 180)
    label.TextSize = 11
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0, 60, 0, 18)
    valLabel.Position = UDim2.new(1, -66, 0, yPos)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(getgenv().CamlockConfig[configKey]) .. (unit or "")
    valLabel.TextColor3 = Color3.fromRGB(0, 255, 65)
    valLabel.TextSize = 11
    valLabel.Font = Enum.Font.Code
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Parent = card

    local sliderBG = Instance.new("Frame")
    sliderBG.Size = UDim2.new(1, -20, 0, 5)
    sliderBG.Position = UDim2.new(0, 10, 0, yPos + 20)
    sliderBG.BackgroundColor3 = Color3.fromRGB(0, 20, 0)
    sliderBG.BorderSizePixel = 1
    sliderBG.BorderColor3 = Color3.fromRGB(0, 100, 35)
    sliderBG.Parent = card

    local sliderFill = Instance.new("Frame")
    local initialPercent = math.clamp((getgenv().CamlockConfig[configKey] - minVal) / (maxVal - minVal), 0, 1)
    sliderFill.Size = UDim2.new(initialPercent, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(0, 255, 65)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBG

    local draggingSlider = false
    sliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position.X
            local absolutePosition = sliderBG.AbsolutePosition.X
            local absoluteSize = sliderBG.AbsoluteSize.X
            local percent = math.clamp((pos - absolutePosition) / absoluteSize, 0, 1)
            
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            local val = minVal + (maxVal - minVal) * percent
            if unit == "" or unit == "px" then
                val = math.floor(val)
            else
                val = math.floor(val * 1000) / 1000
            end
            getgenv().CamlockConfig[configKey] = val
            valLabel.Text = tostring(val) .. (unit or "")
        end
    end)
end

