    btn.MouseButton1Click:Connect(function()
        for _, pObj in pairs(panels) do
            pObj.Visible = false
        end
        for _, child in ipairs(tabsContainer:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(0, 15, 0)
                child.BorderColor3 = Color3.fromRGB(0, 100, 30)
                child.TextColor3 = Color3.fromRGB(100, 200, 100)
            end
        end
        if panels[name] then
            panels[name].Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(0, 40, 10)
            btn.BorderColor3 = getgenv().CamlockConfig.ThemeTextColor
            btn.TextColor3 = getgenv().CamlockConfig.ThemeTextColor
        end
    end)
    return btn
end

