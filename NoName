-- RENDER & GAMEPLAY ENGINE
-- ==============================================================================
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.NumSides = 64
fovCircle.Filled = false
fovCircle.Visible = true

local espCache = {}
local function createDrawing(type, properties)
    local obj = Drawing.new(type)
    for k, v in pairs(properties) do
        obj[k] = v
    end
    return obj
end

local rainbowHue = 0

RunService.RenderStepped:Connect(function(dt)
    if getgenv().CamlockConfig.RainbowColors then
        rainbowHue = (rainbowHue + dt * 0.25) % 1
    end
    local globalRainbowCol = Color3.fromHSV(rainbowHue, 1, 1)
    local activeFOVColor = getgenv().CamlockConfig.RainbowColors and globalRainbowCol or getgenv().CamlockConfig.SilentFOVColor

    fovCircle.Radius = getgenv().CamlockConfig.FOVSize
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    fovCircle.Color = activeFOVColor
    fovCircle.Visible = getgenv().CamlockConfig.MasterSwitch and getgenv().CamlockConfig.SilentAimEnabled and getgenv().CamlockConfig.ShowFOV

    local function isVisible(targetPart)
        if not getgenv().CamlockConfig.WallCheck then return true end
        local origin = Camera.CFrame.Position
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = RaycastParams.FilterType.Exclude
        raycastParams.FilterDescendantsInstances = {player.Character}
        raycastParams.IgnoreWater = true
        local result = Workspace:Raycast(origin, targetPart.Position - origin, raycastParams)
        if result and result.Instance then
            return result.Instance:IsDescendantOf(targetPart.Parent)
        end
        return true
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if not espCache[p] then
                espCache[p] = {
                    Box = createDrawing("Square", {Visible = false, Thickness = 1.5, Filled = false}),
                    HealthBG = createDrawing("Square", {Visible = false, Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Filled = true}),
                    HealthBar = createDrawing("Square", {Visible = false, Thickness = 1, Filled = true}),
                    Tracer = createDrawing("Line", {Visible = false, Thickness = 1}),
                    HeadDot = createDrawing("Circle", {Visible = false, Thickness = 1, Radius = 3, Filled = true}),
                    TorsoLine = createDrawing("Line", {Visible = false, Thickness = 1}),
                    LeftArm = createDrawing("Line", {Visible = false, Thickness = 1}),
                    RightArm = createDrawing("Line", {Visible = false, Thickness = 1}),
                    LeftLeg = createDrawing("Line", {Visible = false, Thickness = 1}),
                    RightLeg = createDrawing("Line", {Visible = false, Thickness = 1}),
                    NameTag = createDrawing("Text", {Visible = false, Size = 13, Center = true, Outline = true}),
                }
            end

            local cache = espCache[p]
            local boxCol = getgenv().CamlockConfig.RainbowColors and globalRainbowCol or getgenv().CamlockConfig.BoxColor
            local skelCol = getgenv().CamlockConfig.RainbowColors and globalRainbowCol or getgenv().CamlockConfig.SkeletonColor
            local tracerCol = getgenv().CamlockConfig.RainbowColors and globalRainbowCol or getgenv().CamlockConfig.TracerColor
            local nameCol = getgenv().CamlockConfig.RainbowColors and globalRainbowCol or getgenv().CamlockConfig.NameColor

            if hrp and head and hum and hum.Health > 0 then
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                if onScreen and isVisible(head) then
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2
                    local boxPos = Vector2.new(hrpPos.X - width / 2, headPos.Y)

                    if getgenv().CamlockConfig.BoxESP then
                        cache.Box.Size = Vector2.new(width, height)
                        cache.Box.Position = boxPos
                        cache.Box.Color = boxCol
                        cache.Box.Visible = true
                    else
                        cache.Box.Visible = false
                    end

                    if getgenv().CamlockConfig.HealthBar then
                        local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        cache.HealthBG.Size = Vector2.new(width, 4)
                        cache.HealthBG.Position = Vector2.new(boxPos.X, boxPos.Y + height + 4)
                        cache.HealthBG.Visible = true

                        cache.HealthBar.Size = Vector2.new(width * healthPercent, 2)
                        cache.HealthBar.Position = cache.HealthBG.Position + Vector2.new(1, 1)
                        cache.HealthBar.Color = Color3.fromRGB(255, (healthPercent * 255), 0)
                        cache.HealthBar.Visible = true
                    else
                        cache.HealthBG.Visible = false
                        cache.HealthBar.Visible = false
                    end

                    if getgenv().CamlockConfig.Skeleton then
                        local lArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")
                        local rArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
                        local lLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
                        local rLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
                        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

                        if head and torso then
                            local hp = Camera:WorldToViewportPoint(head.Position)
                            local tp = Camera:WorldToViewportPoint(torso.Position)
                            cache.HeadDot.Position = Vector2.new(hp.X, hp.Y)
                            cache.HeadDot.Color = skelCol
                            cache.HeadDot.Visible = true

                            cache.TorsoLine.From = Vector2.new(hp.X, hp.Y)
                            cache.TorsoLine.To = Vector2.new(tp.X, tp.Y)
                            cache.TorsoLine.Color = skelCol
                            cache.TorsoLine.Visible = true

                            if lArm then
                                local lap = Camera:WorldToViewportPoint(lArm.Position)
                                cache.LeftArm.From = Vector2.new(tp.X, tp.Y)
                                cache.LeftArm.To = Vector2.new(lap.X, lap.Y)
                                cache.LeftArm.Color = skelCol
                                cache.LeftArm.Visible = true
                            end
                            if rArm then
                                local rap = Camera:WorldToViewportPoint(rArm.Position)
                                cache.RightArm.From = Vector2.new(tp.X, tp.Y)
                                cache.RightArm.To = Vector2.new(rap.X, rap.Y)
                                cache.RightArm.Color = skelCol
                                cache.RightArm.Visible = true
                            end
                            if lLeg then
                                local llp = Camera:WorldToViewportPoint(lLeg.Position)
                                cache.LeftLeg.From = Vector2.new(tp.X, tp.Y)
                                cache.LeftLeg.To = Vector2.new(llp.X, llp.Y)
                                cache.LeftLeg.Color = skelCol
                                cache.LeftLeg.Visible = true
                            end
                            if rLeg then
                                local rlp = Camera:WorldToViewportPoint(rLeg.Position)
                                cache.RightLeg.From = Vector2.new(tp.X, tp.Y)
                                cache.RightLeg.To = Vector2.new(rlp.X, rlp.Y)
                                cache.RightLeg.Color = skelCol
                                cache.RightLeg.Visible = true
                            end
                        end
                    else
                        cache.HeadDot.Visible = false
                        cache.TorsoLine.Visible = false
                        cache.LeftArm.Visible = false
                        cache.RightArm.Visible = false
                        cache.LeftLeg.Visible = false
                        cache.RightLeg.Visible = false
                    end

                    if getgenv().CamlockConfig.Tracers then
                        cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        cache.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y)
                        cache.Tracer.Color = tracerCol
                        cache.Tracer.Visible = true
                    else
                        cache.Tracer.Visible = false
                    end

                    if getgenv().CamlockConfig.NameDisplay then
                        local dist = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and (player.Character.HumanoidRootPart.Position - hrp.Position).Magnitude or 0
                        local distMeters = math.floor(dist * 0.28)
                        local textDisplay = p.Name
                        if getgenv().CamlockConfig.DistanceMeters then
                            textDisplay = textDisplay .. " [" .. tostring(distMeters) .. "m]"
                        end
                        cache.NameTag.Text = textDisplay
                        cache.NameTag.Position = Vector2.new(boxPos.X + (width / 2), boxPos.Y - 18)
                        cache.NameTag.Color = nameCol
                        cache.NameTag.Visible = true
                    else
                        cache.NameTag.Visible = false
                    end
                else
                    cache.Box.Visible = false
                    cache.HealthBG.Visible = false
                    cache.HealthBar.Visible = false
                    cache.Tracer.Visible = false
                    cache.HeadDot.Visible = false
                    cache.TorsoLine.Visible = false
                    cache.LeftArm.Visible = false
                    cache.RightArm.Visible = false
                    cache.LeftLeg.Visible = false
                    cache.RightLeg.Visible = false
                    cache.NameTag.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.HealthBG.Visible = false
                cache.HealthBar.Visible = false
                cache.Tracer.Visible = false
                cache.HeadDot.Visible = false
                cache.TorsoLine.Visible = false
                cache.LeftArm.Visible = false
                cache.RightArm.Visible = false
                cache.LeftLeg.Visible = false
                cache.RightLeg.Visible = false
                cache.NameTag.Visible = false
            end
        end
    end

    if getgenv().CamlockConfig.MasterSwitch then
        pcall(function()
            local bestTarget = nil
            local shortestDist = math.huge
            local bestPlayer = nil
            local selectedPartName = getgenv().CamlockConfig.BodyPart or "Head"

            -- Respect explicit target selector if chosen
            if getgenv().SelectedTargetPlayer and getgenv().SelectedTargetPlayer.Character then
                local tChar = getgenv().SelectedTargetPlayer.Character
                local tPart = tChar:FindFirstChild(selectedPartName) or tChar:FindFirstChild("Head")
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if tPart and tHum and tHum.Health > 0 then
                    bestTarget = tPart
                    bestPlayer = getgenv().SelectedTargetPlayer
                end
            end

            if not bestTarget then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        local targetPart = p.Character:FindFirstChild(selectedPartName) or p.Character:FindFirstChild("Head")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if targetPart and hum and hum.Health > 0 then
                            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                                local withinFOV = not getgenv().CamlockConfig.SilentAimEnabled or (dist <= getgenv().CamlockConfig.FOVSize)
                                if withinFOV and dist < shortestDist then
                                    shortestDist = dist
                                    bestTarget = targetPart
                                    bestPlayer = p
                                end
                            end
                        end
                    end
                end
            end

            -- If Manual Lock Active or Auto-Lock enabled
            if getgenv().CamlockConfig.ManualLockActive and bestTarget and bestPlayer then
                local predictedPos = bestTarget.Position + (bestTarget.AssemblyLinearVelocity * getgenv().CamlockConfig.Prediction)
                local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, getgenv().CamlockConfig.Smoothness)
            elseif getgenv().CamlockConfig.CamlockEnabled and getgenv().CamlockConfig.AutoCamlock and bestTarget and bestPlayer then
                local predictedPos = bestTarget.Position + (bestTarget.AssemblyLinearVelocity * getgenv().CamlockConfig.Prediction)
                local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, getgenv().CamlockConfig.Smoothness)
            end

            if getgenv().CamlockConfig.SilentAimEnabled and getgenv().CamlockConfig.SilentAutoCamlock and bestTarget and bestPlayer then
                local sDist = (Vector2.new(Camera:WorldToViewportPoint(bestTarget.Position).X, Camera:WorldToViewportPoint(bestTarget.Position).Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if sDist <= getgenv().CamlockConfig.FOVSize then
                    local sPredicted = bestTarget.Position + (bestTarget.AssemblyLinearVelocity * getgenv().CamlockConfig.SilentPrediction)
                    local silentCFrame = CFrame.new(Camera.CFrame.Position, sPredicted)
                    Camera.CFrame = Camera.CFrame:Lerp(silentCFrame, getgenv().CamlockConfig.SilentSmoothness)
                end
            end

            -- Update Target Info HUD Card
            if bestPlayer and getgenv().CamlockConfig.ShowTargetInfo then
                targetHud.Visible = true
                if getgenv().CamlockConfig.TargetInfoAvatar then
                    tAvatar.Image = "rbxthumb://type=Avatar&id=" .. bestPlayer.UserId .. "&w=150&h=150"
                else
                    tAvatar.Image = ""
                end

                local infoTextLines = {}
                if getgenv().CamlockConfig.TargetInfoName then
                    table.insert(infoTextLines, "usr: " .. bestPlayer.Name)
                end
                if getgenv().CamlockConfig.TargetInfoDisplay then
                    table.insert(infoTextLines, "alias: " .. bestPlayer.DisplayName)
                end
                if getgenv().CamlockConfig.TargetInfoDist and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and bestPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (player.Character.HumanoidRootPart.Position - bestPlayer.Character.HumanoidRootPart.Position).Magnitude
                    table.insert(infoTextLines, "dist: " .. math.floor(dist * 0.28) .. "m")
                end
                if getgenv().CamlockConfig.TargetInfoHealth and bestPlayer.Character:FindFirstChildOfClass("Humanoid") then
                    table.insert(infoTextLines, "hp: " .. math.floor(bestPlayer.Character:FindFirstChildOfClass("Humanoid").Health))
                end

                tNameLbl.Text = "[TARGET: " .. bestPlayer.Name .. "]"
                tDetailsLbl.Text = table.concat(infoTextLines, "\n")
            else
                targetHud.Visible = false
            end
        end)
    else
        targetHud.Visible = false
    end
end)
