local function findPlayerByDisplayName(nameStr)
    local targetPlr = nil
    local query = string.lower(nameStr)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.DisplayName), query) or string.find(string.lower(p.Name), query) then
            targetPlr = p
            break
        end
    end
    return targetPlr
end

