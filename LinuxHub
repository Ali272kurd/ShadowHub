            targetCharacter = getBestTarget()
        end
        
        if targetCharacter then
            local predictedPos = targetCharacter.Position + (targetCharacter.AssemblyLinearVelocity * settings.prediction)
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, predictedPos)
            Camera.CFrame = currentCF:Lerp(targetCF, settings.smoothness)

            local model = targetCharacter.Parent
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp then
                local tName = model.Name
                local tId = 1
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == model then
                        tName = p.DisplayName
                        tId = p.UserId
                        break
                    end
                end
                pcall(function()
                    hudAvatar.Image = "rbxthumb://type=Avatar&id=" .. tId .. "&w=150&h=150"
                end)

                local distMeters = math.floor((hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude * 0.28)
                hudDetails.Text = string.format("ID: %s\nHP: %d/%d\nDIST: %dm", tName, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth), distMeters)
                targetHudFrame.Visible = true
            end
        else
            targetHudFrame.Visible = false
        end
    else
        targetHudFrame.Visible = false
    end

    -- Process ESP for all real players
    local activePlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp and humanoid.Health > 0 then
                table.insert(activePlayers, {player = p, model = char, humanoid = humanoid, hrp = hrp})
            end
        end
    end

    for entity, _ in pairs(espCache) do
        local exists = false
        for _, ent in ipairs(activePlayers) do
            if ent.model == entity then exists = true break end
        end
        if not exists then removeEsp(entity) end
    end

    for _, ent in ipairs(activePlayers) do
        local model = ent.model
        local hrp = ent.hrp
        local head = model:FindFirstChild("Head")
        local humanoid = ent.humanoid

        if hrp and head and humanoid then
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                if not espCache[model] then
                    local box = Drawing.new("Square")
                    box.Visible = false
                    box.Thickness = 1.5
                    box.Filled = false

                    local tracer = Drawing.new("Line")
                    tracer.Visible = false
                    tracer.Thickness = 1

                    local nameText = Drawing.new("Text")
                    nameText.Visible = false
                    nameText.Color = Color3.fromRGB(255, 255, 255)
                    nameText.Size = 13
                    nameText.Center = true
                    nameText.Outline = true

                    local healthText = Drawing.new("Text")
                    healthText.Visible = false
                    healthText.Color = Color3.fromRGB(0, 255, 65)
                    healthText.Size = 12
                    healthText.Center = true
                    healthText.Outline = true

                    local skeletonLines = {}
                    for i = 1, 10 do
                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Thickness = 1
                        table.insert(skeletonLines, line)
                    end

                    espCache[model] = {box = box, tracer = tracer, name = nameText, health = healthText, skeleton = skeletonLines}
                end

                local cache = espCache[model]
                local headVector = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legVector = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                local height = math.abs(headVector.Y - legVector.Y)
                local width = height / 2

                if settings.espBox then
                    cache.box.Size = Vector2.new(width, height)
                    cache.box.Position = Vector2.new(vector.X - width / 2, headVector.Y)
                    cache.box.Color = currentRainbowColor
                    cache.box.Visible = true
                else
                    cache.box.Visible = false
                end

                if settings.espTracer then
                    cache.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    cache.tracer.To = Vector2.new(vector.X, legVector.Y)
                    cache.tracer.Color = currentRainbowColor
                    cache.tracer.Visible = true
                else
                    cache.tracer.Visible = false
                end

                if settings.espName then
                    cache.name.Text = ent.player.DisplayName
                    cache.name.Position = Vector2.new(vector.X, headVector.Y - 18)
                    cache.name.Visible = true
                else
                    cache.name.Visible = false
                end

                if settings.espHealth then
                    cache.health.Text = math.floor(humanoid.Health) .. " HP"
                    cache.health.Position = Vector2.new(vector.X, legVector.Y + 4)
                    cache.health.Visible = true
                else
                    cache.health.Visible = false
                end

                if settings.espSkeleton then
                    local upperTorso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
                    local lowerTorso = model:FindFirstChild("LowerTorso") or upperTorso
                    local leftUpperArm = model:FindFirstChild("LeftUpperArm") or model:FindFirstChild("Left Arm")
                    local leftLowerArm = model:FindFirstChild("LeftLowerArm") or leftUpperArm
                    local rightUpperArm = model:FindFirstChild("RightUpperArm") or model:FindFirstChild("Right Arm")
                    local rightLowerArm = model:FindFirstChild("RightLowerArm") or rightUpperArm
                    local leftUpperLeg = model:FindFirstChild("LeftUpperLeg") or model:FindFirstChild("Left Leg")
                    local leftLowerLeg = model:FindFirstChild("LeftLowerLeg") or leftUpperLeg
                    local rightUpperLeg = model:FindFirstChild("RightUpperLeg") or model:FindFirstChild("Right Leg")
                    local rightLowerLeg = model:FindFirstChild("RightLowerLeg") or rightUpperLeg

                    local bones = {
                        {head, upperTorso},
                        {upperTorso, lowerTorso},
                        {upperTorso, leftUpperArm}, {leftUpperArm, leftLowerArm},
                        {upperTorso, rightUpperArm}, {rightUpperArm, rightLowerArm},
                        {lowerTorso, leftUpperLeg}, {leftUpperLeg, leftLowerLeg},
                        {lowerTorso, rightUpperLeg}, {rightUpperLeg, rightLowerLeg}
                    }

                    for i, bone in ipairs(bones) do
                        local p1, p2 = bone[1], bone[2]
                        local lineObj = cache.skeleton[i]
                        if p1 and p2 and lineObj then
                            local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
                            local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
                            if on1 and on2 then
                                lineObj.From = Vector2.new(v1.X, v1.Y)
                                lineObj.To = Vector2.new(v2.X, v2.Y)
                                lineObj.Color = currentRainbowColor
                                lineObj.Visible = true
                            else
                                lineObj.Visible = false
                            end
                        elseif lineObj then
                            lineObj.Visible = false
                        end
                    end
                else
                    for _, lineObj in ipairs(cache.skeleton) do lineObj.Visible = false end
                end
            else
                removeEsp(model)
            end
        else
            removeEsp(model)
        end
    end
end)
