local espCache = {}

local function removeEsp(entity)
    if espCache[entity] then
        pcall(function()
            if espCache[entity].box then espCache[entity].box:Remove() end
            if espCache[entity].tracer then espCache[entity].tracer:Remove() end
            if espCache[entity].name then espCache[entity].name:Remove() end
            if espCache[entity].health then espCache[entity].health:Remove() end
            if espCache[entity].skeleton then
                for _, lineObj in ipairs(espCache[entity].skeleton) do lineObj:Remove() end
            end
        end)
        espCache[entity] = nil
    end
end

