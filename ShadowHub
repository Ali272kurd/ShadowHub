-- FPS BOOST - FULLY WORKING
-- ==================================================

local fpsSettings = {
    noShadowsEnabled = false,
    noGrassEnabled = false,
    graySkyEnabled = false,
    noClothesEnabled = false,
    noFogEnabled = false,
    lowGraphicsEnabled = false,
    resolution = 1080,
}

-- Store original values for reset
local originalValues = {}

local function applyFPSBoost()
    pcall(function()
        -- Save original values first time
        if not originalValues.shadows then
            originalValues.shadows = Lighting.GlobalShadows
            originalValues.ambient = Lighting.Ambient
            originalValues.fogEnd = Lighting.FogEnd
            originalValues.fogStart = Lighting.FogStart
            originalValues.brightness = Lighting.Brightness
        end
        
        -- 1. DISABLE SHADOWS
        if fpsSettings.noShadowsEnabled then
            Lighting.GlobalShadows = false
            Lighting.ShadowSoftness = 0
        else
            Lighting.GlobalShadows = originalValues.shadows
        end
        
        -- 2. REMOVE GRASS - Find and hide grass parts
        if fpsSettings.noGrassEnabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Part") or obj:IsA("MeshPart") then
                    local name = obj.Name:lower()
                    if name:find("grass") or name:find("leaf") or name:find("plant") or name:find("bush") or name:find("tree") then
                        pcall(function()
                            obj.Transparency = 1
                            obj.CanCollide = false
                        end)
                    end
                end
            end
        else
            -- Restore grass visibility
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Part") or obj:IsA("MeshPart") then
                    local name = obj.Name:lower()
                    if name:find("grass") or name:find("leaf") or name:find("plant") or name:find("bush") or name:find("tree") then
                        pcall(function()
                            obj.Transparency = 0
                            obj.CanCollide = true
                        end)
                    end
                end
            end
        end
        
        -- 3. GRAY SKY
        if fpsSettings.graySkyEnabled then
            Lighting.Ambient = Color3.fromRGB(128, 128, 128)
            Lighting.Brightness = 1
        else
            Lighting.Ambient = originalValues.ambient or Color3.fromRGB(127, 127, 127)
            Lighting.Brightness = originalValues.brightness or 1
        end
        
        -- 4. REMOVE CLOTHES - Hide clothing parts on all characters
        if fpsSettings.noClothesEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    for _, part in ipairs(plr.Character:GetChildren()) do
                        if part:IsA("Part") or part:IsA("MeshPart") then
                            local name = part.Name:lower()
                            if name:find("shirt") or name:find("pants") or name:find("clothes") or name:find("torso") or name:find("arm") or name:find("leg") then
                                pcall(function()
                                    part.Transparency = 0.8
                                    part.Material = Enum.Material.SmoothPlastic
                                end)
                            end
                        end
                    end
                end
            end
        else
            -- Restore clothes visibility
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    for _, part in ipairs(plr.Character:GetChildren()) do
                        if part:IsA("Part") or part:IsA("MeshPart") then
                            local name = part.Name:lower()
                            if name:find("shirt") or name:find("pants") or name:find("clothes") or name:find("torso") or name:find("arm") or name:find("leg") then
                                pcall(function()
                                    part.Transparency = 0
                                    part.Material = Enum.Material.Plastic
                                end)
                            end
                        end
                    end
                end
            end
        end
        
        -- 5. DISABLE FOG
        if fpsSettings.noFogEnabled then
            Lighting.FogEnd = 999999
            Lighting.FogStart = 999999
        else
            Lighting.FogEnd = originalValues.fogEnd or 100000
            Lighting.FogStart = originalValues.fogStart or 0
        end
        
        -- 6. LOW GRAPHICS
        if fpsSettings.lowGraphicsEnabled then
            Lighting.ClockTime = 12
            Lighting.Brightness = 0.8
            Lighting.ExposureCompensation = -0.5
        end
        
        -- 7. CAMERA FARNESS
        pcall(function()
            Workspace.CurrentCamera.MaxDistance = fpsSettings.resolution
        end)
    end)
end

-- ==================================================
-- ULTRA HDR - ENHANCED 100x
-- ==================================================

local hdrSettings = {
    enabled = false,
    brightness = 1.5,
    contrast = 1.8,
    saturation = 2.0,
    bloom = 1.5,
    exposure = 1.0,
    gamma = 0.8,
    sharpness = 1.2,
    vibrance = 1.5,
    temperature = 0.5,
    tint = 0.3,
}

local function applyHDR()
    pcall(function()
        if hdrSettings.enabled then
            -- High-end HDR effects
            Lighting.Brightness = hdrSettings.brightness * 1.8
            Lighting.Ambient = Color3.fromRGB(
                math.clamp(127 * hdrSettings.saturation * hdrSettings.vibrance, 0, 255),
                math.clamp(127 * hdrSettings.saturation, 0, 255),
                math.clamp(127 * hdrSettings.saturation * hdrSettings.vibrance, 0, 255)
            )
            Lighting.OutdoorAmbient = Color3.fromRGB(
                math.clamp(127 * hdrSettings.contrast, 0, 255),
                math.clamp(127 * hdrSettings.contrast, 0, 255),
                math.clamp(127 * hdrSettings.contrast, 0, 255)
            )
            Lighting.ExposureCompensation = hdrSettings.exposure * 1.5
            Lighting.ClockTime = 14.5
            Lighting.GlobalShadows = true
            Lighting.ShadowSoftness = 0.3
            
            -- Bloom effect through ColorShift
            Lighting.ColorShift_Top = Color3.fromRGB(
                math.clamp(255 * hdrSettings.bloom * 0.3, 0, 255),
                math.clamp(255 * hdrSettings.bloom * 0.1, 0, 255),
                math.clamp(255 * hdrSettings.bloom * 0.2, 0, 255)
            )
            
            -- Temperature/Tint
            local tempR = 1 + (hdrSettings.temperature * 0.2)
            local tempB = 1 - (hdrSettings.temperature * 0.2)
            Lighting.ColorShift_Bottom = Color3.fromRGB(
                math.clamp(200 * tempR, 0, 255),
                math.clamp(200 * (1 - hdrSettings.tint * 0.1), 0, 255),
                math.clamp(200 * tempB, 0, 255)
            )
            
            -- Gamma correction via Atmosphere
            Lighting.Atmosphere = Instance.new("Atmosphere")
            Lighting.Atmosphere.Parent = Lighting
            Lighting.Atmosphere.Density = hdrSettings.gamma * 0.3
            Lighting.Atmosphere.Offset = hdrSettings.gamma * 0.2
            Lighting.Atmosphere.Color = Color3.fromRGB(200, 200, 220)
            Lighting.Atmosphere.Decay = Enum.AtmosphereDecay.Linear
            
        else
            -- Reset HDR
            Lighting.Brightness = 1
            Lighting.Ambient = Color3.fromRGB(127, 127, 127)
            Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
            Lighting.ExposureCompensation = 0
            Lighting.ClockTime = 14
            Lighting.ColorShift_Top = Color3.fromRGB(0, 0, 0)
            Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
            
            local atmo = Lighting:FindFirstChild("Atmosphere")
            if atmo then
                atmo:Destroy()
            end
        end
    end)
end

