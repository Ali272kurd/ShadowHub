                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local rightVec = root.CFrame.RightVector
                            local newPos = root.Position + rightVec * teleportSteps
                            local tween = TweenService:Create(root, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {CFrame = CFrame.new(newPos)})
                            tween:Play()
